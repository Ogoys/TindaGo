# Expo EAS Ignore File
# Reduces upload size by excluding unnecessary files

# Documentation
*.md
docs/
doc/

# Git
.git/
.gitignore
.gitattributes

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Node modules (will be installed on EAS)
# node_modules/ # Don't ignore, needed for build

# Build outputs
dist/
dist-test/
build/
.expo/

# Test files
__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx

# Scripts
scripts/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment (using EAS secrets instead)
.env.local
.env.development
.env.test

# Temporary files
*.tmp
*.temp
.cache/
