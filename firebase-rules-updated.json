{
  "rules": {
    ".read": true,
    "settings": {
      ".write": true
    },
    "admins": {
      ".write": true
    },
    "roles": {
      ".write": true
    },
    "indexes": {
      ".write": true
    },
    "products": {
      ".indexOn": ["storeOwnerId", "status", "expiryDate"]
    },
    "damages_spoilage": {
      ".indexOn": ["storeOwnerId", "createdAt"]
    },
    "damages": {
      ".indexOn": ["storeOwnerId", "createdAt", "reason"]
    },
    "return_goods": {
      ".indexOn": ["customerId", "storeId", "storeOwnerId", "status", "reason", "orderNumber"]
    },
    "returns": {
      ".indexOn": ["storeOwnerId", "status"]
    },
    "orders": {
      ".write": true,
      ".indexOn": ["customerId", "storeId", "storeOwnerId", "status", "paymentStatus", "debtStatus"]
    },
    "purchase_orders": {
      ".write": true,
      ".indexOn": ["storeOwnerId", "createdAt"]
    },
    "purchaseOrders": {
      ".indexOn": ["storeOwnerId", "createdAt"]
    },
    "walk_in_sales": {
      ".indexOn": ["storeOwnerId", "createdAt"]
    },
    "walkInSales": {
      ".indexOn": ["storeOwnerId", "createdAt"]
    },
    "suppliers": {
      ".indexOn": ["storeOwnerId", "createdAt", "name"]
    },
    "users": {
      ".indexOn": ["role", "email", "phoneNumber"]
    },
    "stores": {
      ".indexOn": ["ownerId", "status", "isOpen"]
    },
    "reviews": {
      ".indexOn": ["storeId", "customerId", "orderId", "productId"]
    },
    "cart": {
      ".indexOn": ["userId", "storeId"]
    },
    "carts": {
      ".indexOn": ["userId", "storeId"]
    },
    "wallets": {
      ".write": true,
      ".indexOn": ["storeId"]
    },
    "payouts": {
      ".indexOn": ["storeId", "status"]
    },
    "ledgers": {
      ".write": true,
      "stores": {
        "$storeId": {
          "transactions": {
            ".indexOn": ["createdAt", "type"]
          }
        }
      }
    },
    "processed_webhooks": {
      ".write": true
    },
    ".write": "auth != null"
  }
}
